#!/bin/sh

pgrep -x sxhkd > /dev/null || setsid sxhkd >/dev/null 2>&1 &

bspc monitor eDP1 -d I II III IV V VI VII VIII IX X

bspc config border_width         2
bspc config window_gap          10

bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

bspc rule -a Gimp desktop='^4' state=tiled follow=off
bspc rule -a chatterino desktop='^9' state=tiled follow=off
bspc rule -a discord desktop='^9' state=tiled follow=off
bspc rule -a Firefox desktop='^2' state=tiled follow=off
bspc rule -a 'Dwarf Fortress' desktop='^5' state=fullscreen follow=off
bspc rule -a Steam desktop='^4' state=tiled follow=off
bspc rule -a Lutris desktop='^4' state=tiled follow=off

#start lemonbar
~/syscomps/bar/bspwmbar/panel &
