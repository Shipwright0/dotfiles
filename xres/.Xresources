URxvt.font:xft:Iosevka Nerd Font:size=12, xft:DejaVuSansM Nerd Font Mono:pixelsize=12
URxvt.scrollBar: false
URxvt.depth: 30

!Perl Extensions
URxvt.perl-ext-common: default,clipboard
URxvt.clipboard.autocopy: true
URxvt.keysym.M-c: perl:clipboard:copy
URxvt.keysym.M-v: perl:clipboard:paste

Sxiv.font:Iosevka Nerd Font:size=12
Sxiv.background:#000000
Sxiv.foreground:#00C0FF

! special
*foreground:   #fce8c3
*background:   #121110
*cursorColor:  #fed06e

!normal
